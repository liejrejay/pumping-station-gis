# 複製為 .env 後填入（.env 不會被 commit）
#   cp .env.example .env
#
# 本機請用 node server.js 開啟，不要用 file:// 直接開 HTML
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# 中央氣象署開放資料授權碼 https://opendata.cwa.gov.tw/
# 本機 npm start 即時查詢；GitHub Actions Secret 同名稱 → 公開站部署快照
CWA_API_KEY=YOUR_CWA_AUTHORIZATION_CODE_HERE

# 共用後端 API 根網址（Render 部署後填入，結尾不要加 /api）
# 例：https://pumping-station-api.onrender.com
# GitHub Actions Secret 同名稱 → 公開站全組註冊／登入／統計
PUBLIC_API_BASE_URL=
