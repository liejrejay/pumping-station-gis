{
  "name": "dahan-river-pumping-station-system",
  "version": "1.0.0",
  "description": "雙北大漢溪抽水站管理系統",
  "main": "server.js",
  "scripts": {
    "start": "node scripts/write-runtime-config.js && node server.js",
    "dev": "node scripts/write-runtime-config.js && nodemon server.js",
    "config:local": "node scripts/write-runtime-config.js",
    "install-deps": "npm install express cors",
    "build": "npm run build:clean && npm run build:copy && npm run build:config",
    "build:clean": "rm -rf dist || rmdir /s dist",
    "build:copy": "mkdir dist 2>nul & xcopy *.html dist\\ /y & xcopy css dist\\css\\ /e /y & xcopy js dist\\js\\ /e /y & xcopy data dist\\data\\ /e /y",
    "build:config": "node build-config.js"
  },
  "keywords": [
    "gis",
    "pumping-station",
    "taiwan",
    "water-management"
  ],
  "author": "GIS Team",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "mongodb": "^6.21.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
